#include <stdio.h>
#include <stdlib.h>

// allocating a N x N grid dynamically using double pointers(int **)
int** allocateGrind(int N){
    int** grid=(int **)calloc(N,sizeof(int *));
    if(grid==NULL){
        fprintf(stderr,"Error:Memory Allocations failed for row pointers.\n");
        exit(1);
    }
    for(int i=0;i<N;i++){
        grid[i]=(int *)calloc(N,sizeof(int));
        if(grid[i]==NULL){
            fprintf(stderr,"Error:Memory Allocation failed for grid row.\n");
            for(int j=0;j<i;j++){
                free(grid[j]);
            }
            free(grid);
            exit(1);
        }
    }
    return grid;
}
// freeing 2D arry memory using double pointers(int**)
void freeGrid(int **grid,int N){
    if(grid==NULL) return;
    for(int i=0; i<N;i++){//freeing starting element of each row which are actually (pointer in array) for the strings , char arrays
        free(grid[i]);
    }
    free(grid);
}
// lets count the 8 cnnected live surrounding neighbour cells
int countLiveNeighbours(int **grid,int N,int r,int c){
    int count=0;
    for(int dr=-1;dr<=1;dr++){
        for(int dc=-1;dc<=1;dc++){
            if(dc==0 && dr==0)continue;//skipping the main cell around which we are looking for 8 live cells
            int nr=r+dr;// row index of surrounding cell
            int nc=c+dc;//column index of surrounding cell

            if(nr>=0 && nr<N && nc>=0 && nc<N){// making sure the nieghbours dont overflow outside the grid bounderies ,if not count it 
                if(grid[nr][nc]==1)count ++;
            }
        }
    }
    return count;
}
/* after all the functionality and validations now it is time to print the grid 
according to the required number of generations. the parameters are gonna be the
 grid, N (the size of grid) and finally the number of generations required*/
void printGrid(int **grid,int N,int generations){
    printf("Generation %d \n",generations); 
    for(int i =0;i<N;i++){
        for(int j=0;j<N;j++){
            printf("%d ",grid[i][j]);
        }
        printf("\n");
    }
    printf("\n");
}
/* Now the main function where passing value using command line using int argc 
and char *argv and also checking for command line validation.Argc counts arguements,
while char *argv is an pointer array containing pointer to each arguement as*/
int main(int argc, char *argv[]){
    //Requiremnt 1:command line validation (argc==2)
    if(argc!=2){
        fprintf(stderr,"Error:Missing Input Filename\n");
        fprintf(stderr,"Usage: %s <input_filename>\n",argv[0]);
        return 1;
    }
    FILE *file=fopen(argv[1],"r");
    if(file==NULL){
        fprintf(stderr,"Error: could not open file '%s'\n",argv[1]);
        return 1;
    }

    int N,G;
    if(fscanf(file,"%d %d",&N,&G)!= 2){
        fprintf(stderr, "error unable to read N and G \n");
        fclose(file);
        return 1;
    }
    if(N<=0 || G<0){
        fprintf(stderr,"Error: N must be positive and G must be non-negative.\n");
        fclose(file);
        return 1;
    }
    // Now locally call function to dynamically allocate grid (int**) for n gerneration
    int **curr_grid=allocateGrind(N);
    int **next_grid=allocateGrind(N);
    //reading grid values from file
    for(int i=0;i<N;i++){
        for(int j=0;j<N;j++){
            if(fscanf(file,"%d",&curr_grid[i][j])!=1){
                fprintf(stderr,"Error reading grid at [%d][%d]\n",i,j);
                freeGrid(curr_grid,N);
                freeGrid(next_grid,N);
                fclose(file);
                return 1;
            }
        }
    }
    fclose(file);
    printGrid(curr_grid,N,0);

// now we implement the simulation loop over G generations
for(int gen=1;gen<=G;gen++){
    for(int r=0;r<N;r++){
        for(int c=0;c<N;c++){
            int neigbours=countLiveNeighbours(curr_grid,N,r,c);
        
            if(curr_grid[r][c]==1){
                //overpopulation (>3) or underpopulation (<2)
                if(neigbours<2 || neigbours>3){
                    next_grid[r][c]=0;
                }else {
                    next_grid[r][c]=1; //survival for 2 or 3
                }
            }
            else{//Reproduction for exactly 3
                if(neigbours==3){
                    next_grid[r][c]=1;
                }else{
                    next_grid[r][c]=0;
                }
                    
            }
        }
    }
    // swap grids after each generation so the next generation uses this result
    int **temp=curr_grid;
    curr_grid=next_grid;
    next_grid=temp;

    printGrid(curr_grid,N,gen);
}

// Simply free the two grids so the swapping can happening for the 2 generation and more if start from 0th generation
freeGrid(curr_grid,N);
freeGrid(next_grid,N);

return 0;
}

