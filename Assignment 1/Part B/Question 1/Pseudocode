Start

Input N

HotelRevenue = 0

For i = 1 to N

    Input Season
    Input Room
    Input Nights

    If Season = 1 

        If Room = 1 
            Rate = 5000
        Else if Room = 2 
            Rate = 8000
        Else
            Rate = 12000
        End if

    Else

        If Room = 1 
            Rate = 3000
        Else if Room = 2 
            Rate = 5000
        Else
            Rate = 8000
        End if

    End if

    TotalPrice = Rate × Nights

    If Nights > 7 
        Discount = TotalPrice × 15 / 100
        TotalPrice = TotalPrice - Discount
    End if

    Print TotalPrice

    HotelRevenue = HotelRevenue + TotalPrice

End for

Print HotelRevenue

Stop
