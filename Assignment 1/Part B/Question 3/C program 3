#include <stdio.h>

int main()
{
    int N, i, j, mark, sum;
    float average;

    printf("Enter number of students: ");
    scanf("%d", &N);

i=1;
while(i<=N)
    {
        sum = 0;
        int subjectDeficiency = 0;

        printf("\nStudent %d\n", i);

      j=1;
    while(j<=5)
        {
           while(1)
           {
            printf("Enter mark for subject %d: ", j);   // Out of 100
            scanf("%d", &mark);
            if (mark<=100 )
               
                 if (mark>=0)
			
                break;

            printf("Invalid marks out of 100 for subject %d\n",j);
             }

            sum = sum + mark;

            if (mark < 33)
            {
                subjectDeficiency = 'Y';           // Y for Yes & N for No
            }
       j++;
        }

        average = sum / 5.0;

        printf("Total Marks = %d\n", sum);
        printf("Average = %.2f\n", average);

        if (subjectDeficiency == 'Y')
        {
            printf("Result: Fail - Subject Deficiency\n");
        }
        else if (average >= 80)
        {
            printf("Result: Distinction\n");
        }
        else if (average >= 60)
        {
            printf("Result: Pass\n");
        }
        else
        {
            printf("Result: Fail\n");
        }
i++;
    }

    return 0;
}
