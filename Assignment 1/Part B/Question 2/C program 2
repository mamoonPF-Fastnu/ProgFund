#include <stdio.h>

int main()
{
    int N, i, request;
    int currentFloor = 0;

    printf("Enter number of floor requests: ");
    scanf("%d", &N);
    
   i=1;
    while(i<= N)
    {
        printf("Enter floor request %d: ", i);
        scanf("%d", &request);

        if (request > currentFloor)
        {
            printf("Moving Up\n");
        }
        else if (request < currentFloor)
        {
            printf("Moving Down\n");
        }
        else
        {
            printf("Doors Opening\n");
        }

        currentFloor = request;

        printf("Current Floor: %d\n\n", currentFloor);
        i++;
    }

    return 0;
}
